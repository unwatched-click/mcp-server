{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.unwatched-click/mcp-server",
  "title": "Unwatched",
  "description": "Subtitles, frames, metadata, translations and AI summaries of YouTube videos for AI agents.",
  "websiteUrl": "https://unwatched.click/en/api-docs",
  "repository": {
    "url": "https://github.com/unwatched-click/mcp-server",
    "source": "github"
  },
  "version": "0.2.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.unwatched.click/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "unwatched-click-mcp",
      "version": "0.2.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "UNWATCHED_API_KEY",
          "description": "Unwatched API key (unw_sk_...) from https://unwatched.click/en/developer/keys",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
