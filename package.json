{
  "name": "unwatched-click-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.unwatched-click/mcp-server",
  "description": "MCP server for Unwatched: let AI agents read YouTube videos (subtitles, frames, metadata, summaries).",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "unwatched-click-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "typecheck": "tsc --noEmit",
    "start": "node build/index.js",
    "http": "MCP_TRANSPORT=http node build/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unwatched-click/mcp-server.git"
  },
  "homepage": "https://unwatched.click/en/api-docs",
  "bugs": {
    "url": "https://github.com/unwatched-click/mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "youtube",
    "subtitles",
    "transcript",
    "ai-agents",
    "unwatched"
  ],
  "author": "Unwatched",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
