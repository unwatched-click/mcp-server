# Unwatched MCP server configuration.
# Copy to .env (or export in your shell) and fill in the values.

# Required: Unwatched API key.
# Create one at https://unwatched.click/en/developer/keys (format: unw_sk_...)
UNWATCHED_API_KEY=

# Optional: base URL of the Unwatched REST API.
# Leave empty for the default https://api.unwatched.click
UNWATCHED_API_BASE=

# Optional: transport to serve, "stdio" (default) or "http".
MCP_TRANSPORT=

# Optional: port to listen on in http mode. Leave empty for the default 3002.
PORT=

# Optional: claim token for the Glama directory listing of the hosted
# deployment. Not used in local stdio mode.
GLAMA_CLAIM_TOKEN=

# Optional: claim token for the MCPRush directory listing of the hosted
# deployment. Not used in local stdio mode.
MCPRUSH_CLAIM_TOKEN=
